<resources>
    <style name="AppThemeBase" parent="LumenNativeActionsDark">
        <item name="android:alertDialogTheme">@style/LumenDialog</item>
        <item name="android:editTextStyle">@style/LumenInput</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#79D8EC</item>
        <item name="android:colorControlNormal">#91A9B8</item>
        <item name="android:colorButtonNormal">#15212C</item>
        <item name="android:colorBackgroundFloating">#131E28</item>
        <item name="android:textColorPrimary">#EEF3F5</item>
        <item name="android:textColorSecondary">#91A9B8</item>
        <item name="android:windowBackground">#0B1117</item>
        <item name="android:statusBarColor">#0B1117</item>
        <item name="android:navigationBarColor">#0B1117</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="LumenDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:colorAccent">#79D8EC</item><item name="android:colorButtonNormal">#15212C</item>
        <item name="android:textColorPrimary">#EEF3F5</item><item name="android:textColorSecondary">#91A9B8</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="LumenInput" parent="android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/input_surface</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">12dp</item><item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item><item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">14sp</item><item name="android:textColorHint">#91A9B8</item>
    </style>
    <style name="LumenNativeActionsDark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="materialButtonStyle">@style/Widget.Material3.Button.TonalButton</item>
        <item name="colorPrimary">@color/lumen_dark_primary</item>
        <item name="colorOnPrimary">@color/lumen_dark_on_primary</item>
        <item name="colorPrimaryInverse">@color/lumen_dark_inverse_primary</item>
        <item name="colorPrimaryContainer">@color/lumen_dark_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/lumen_dark_on_primary_container</item>
        <item name="colorSecondary">@color/lumen_dark_secondary</item>
        <item name="colorOnSecondary">@color/lumen_dark_on_secondary</item>
        <item name="colorSecondaryContainer">@color/lumen_dark_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/lumen_dark_on_secondary_container</item>
        <item name="colorTertiary">@color/lumen_dark_tertiary</item>
        <item name="colorOnTertiary">@color/lumen_dark_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/lumen_dark_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/lumen_dark_on_tertiary_container</item>
        <item name="colorSurface">@color/lumen_dark_surface</item>
        <item name="colorOnSurface">@color/lumen_dark_on_surface</item>
        <item name="android:colorBackground">@color/lumen_dark_background</item>
        <item name="colorOnBackground">@color/lumen_dark_on_background</item>
        <item name="colorSurfaceVariant">@color/lumen_dark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/lumen_dark_on_surface_variant</item>
        <item name="colorOutline">@color/lumen_dark_outline</item>
        <item name="colorOutlineVariant">@color/lumen_dark_outline_variant</item>
        <item name="colorSurfaceDim">@color/lumen_dark_surface_dim</item>
        <item name="colorSurfaceBright">@color/lumen_dark_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/lumen_dark_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/lumen_dark_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/lumen_dark_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/lumen_dark_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/lumen_dark_surface_container_highest</item>
        <item name="colorError">@color/lumen_dark_error</item>
        <item name="colorOnError">@color/lumen_dark_on_error</item>
        <item name="colorErrorContainer">@color/lumen_dark_error_container</item>
        <item name="colorOnErrorContainer">@color/lumen_dark_on_error_container</item>
        <item name="android:windowBackground">@color/lumen_dark_background</item>
        <item name="android:colorAccent">@color/lumen_dark_primary</item>
        <item name="android:textColorPrimary">@color/lumen_dark_on_surface</item>
        <item name="android:textColorSecondary">@color/lumen_dark_on_surface_variant</item>
        <item name="android:colorControlNormal">@color/lumen_dark_on_surface_variant</item>
        <item name="colorControlNormal">@color/lumen_dark_on_surface_variant</item>
        <item name="colorControlActivated">@color/lumen_dark_primary</item>
        <item name="android:colorBackgroundFloating">@color/lumen_dark_surface_container</item>
    </style>
    <style name="LumenNativeActionsLight" parent="Theme.Material3.Light.NoActionBar">
        <item name="materialButtonStyle">@style/Widget.Material3.Button.TonalButton</item>
        <item name="colorPrimary">@color/lumen_light_primary</item>
        <item name="colorOnPrimary">@color/lumen_light_on_primary</item>
        <item name="colorPrimaryInverse">@color/lumen_light_inverse_primary</item>
        <item name="colorPrimaryContainer">@color/lumen_light_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/lumen_light_on_primary_container</item>
        <item name="colorSecondary">@color/lumen_light_secondary</item>
        <item name="colorOnSecondary">@color/lumen_light_on_secondary</item>
        <item name="colorSecondaryContainer">@color/lumen_light_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/lumen_light_on_secondary_container</item>
        <item name="colorTertiary">@color/lumen_light_tertiary</item>
        <item name="colorOnTertiary">@color/lumen_light_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/lumen_light_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/lumen_light_on_tertiary_container</item>
        <item name="colorSurface">@color/lumen_light_surface</item>
        <item name="colorOnSurface">@color/lumen_light_on_surface</item>
        <item name="android:colorBackground">@color/lumen_light_background</item>
        <item name="colorOnBackground">@color/lumen_light_on_background</item>
        <item name="colorSurfaceVariant">@color/lumen_light_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/lumen_light_on_surface_variant</item>
        <item name="colorOutline">@color/lumen_light_outline</item>
        <item name="colorOutlineVariant">@color/lumen_light_outline_variant</item>
        <item name="colorSurfaceDim">@color/lumen_light_surface_dim</item>
        <item name="colorSurfaceBright">@color/lumen_light_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/lumen_light_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/lumen_light_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/lumen_light_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/lumen_light_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/lumen_light_surface_container_highest</item>
        <item name="colorError">@color/lumen_light_error</item>
        <item name="colorOnError">@color/lumen_light_on_error</item>
        <item name="colorErrorContainer">@color/lumen_light_error_container</item>
        <item name="colorOnErrorContainer">@color/lumen_light_on_error_container</item>
        <item name="android:windowBackground">@color/lumen_light_background</item>
        <item name="android:colorAccent">@color/lumen_light_primary</item>
        <item name="android:textColorPrimary">@color/lumen_light_on_surface</item>
        <item name="android:textColorSecondary">@color/lumen_light_on_surface_variant</item>
        <item name="android:colorControlNormal">@color/lumen_light_on_surface_variant</item>
        <item name="colorControlNormal">@color/lumen_light_on_surface_variant</item>
        <item name="colorControlActivated">@color/lumen_light_primary</item>
        <item name="android:colorBackgroundFloating">@color/lumen_light_surface_container</item>
    </style>
    <style name="LumenNativeDropdown" parent="LumenNativeActionsDark">
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu</item>
        <item name="autoCompleteTextViewStyle">@style/Widget.Material3.AutoCompleteTextView.OutlinedBox</item>
    </style>
    <style name="LumenLibraryFilterSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="enableEdgeToEdge">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="LumenNativeCardIconsDark" parent="LumenNativeActionsDark">
        <item name="materialButtonStyle">@style/LumenCardIconButton</item>
    </style>
    <style name="LumenNativeCardIconsLight" parent="LumenNativeActionsLight">
        <item name="materialButtonStyle">@style/LumenCardIconButton</item>
    </style>
    <style name="LumenCardIconButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:insetLeft">8dp</item>
        <item name="android:insetRight">8dp</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
</resources>
